#
# Runtime image: the prebuilt static musl binary on an empty root (`scratch`).
# Build the binaries first (`cargo xtask dist --target <triple> --release`);
# see docs/development.md, "Building the image".
#
# Nothing is needed from a base image, so there is none (nothing to patch,
# nothing for a scanner to find besides the binary's own crates):
#   - TLS: in-cluster (the supported deployment, via the chart) the kube client
#     trusts the API server CA from the mounted ServiceAccount (ca.crt), so no
#     system CA bundle is needed. Without an explicit CA, kube-client would use
#     rustls-platform-verifier, which reads the system roots (this image has
#     none; running it against a kubeconfig with no CA is not supported);
#   - time: UTC only, no /usr/share/zoneinfo;
#   - the process writes nothing to disk (read-only root filesystem), so no
#     /tmp and no home directory;
#   - the user is numeric, so no /etc/passwd is needed.
# Image config that distroless used to set and is dropped on purpose: PATH
# (the ENTRYPOINT is an absolute path and there is no shell to search for
# anything; some builders inject a default PATH into the config anyway, which
# is harmless), SSL_CERT_FILE (see TLS above) and WORKDIR /home/nonroot (the
# working directory stays `/`; nothing is read or written relative to it).
FROM scratch

# Re-declared: build args are only visible in the stage that declares them.
ARG TARGETARCH
ARG VERSION=dev
ARG REVISION=unknown

LABEL org.opencontainers.image.title="secretspec-operator" \
      org.opencontainers.image.description="Kubernetes operator that generates and keeps Secrets from declarative SecretSpec resources." \
      org.opencontainers.image.source="https://github.com/jabbas/secretspec-operator" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

COPY target/dist/${TARGETARCH}/secretspec-operator /secretspec-operator
# Licence bundle: this project's LICENSE and NOTICE, the licence texts of the
# third-party crates compiled into the binary, and an index. Generated by
# `cargo xtask licenses` (run it before the build).
COPY target/dist/licenses/ /licenses/

# Numeric on purpose: there is no /etc/passwd to resolve a name. The chart sets
# runAsUser/runAsGroup 65532 as well.
USER 65532:65532
ENTRYPOINT ["/secretspec-operator"]
